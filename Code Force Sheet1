//t)Sort Numbers
#include <stdio.h>

int main() {
    int a, b, c;
    scanf("%d %d %d", &a, &b, &c);
    
    int min = (a <= b && a <= c) ? a : ((b <= c) ? b : c);
    int max = (a >= b && a >= c) ? a : ((b >= c) ? b : c);
    int mid = (a + b + c) - min - max;
   
    printf("%d\n%d\n%d\n\n", min, mid, max);
    printf("%d\n%d\n%d\n", a, b, c);

    return 0;
}
