//z)	Hard Compare
#include <stdio.h>
#include <math.h>

int main() {
    long long a, b, c, d;
    scanf("%lld %lld %lld %lld", &a, &b, &c, &d);
    double left_side = b * log(a);
    double right_side = d * log(c);

    if (left_side > right_side) {
        printf("YES\n");
    } else {
        printf("NO\n");
    }

    return 0;
}
