  //j)J - Primes from 1 to n
 #include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    for (int i = 2; i <= N; i++) { 
        int isPrime = 1;

        for (int j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = 0;
                break;
            }
        }

        if (isPrime) {
            printf("%d ", i);
        }
    }

    return 0;
}
