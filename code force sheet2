  //e)E - Max	
  #include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);

    long long num, max;

   
    scanf("%lld", &max);

    for(int i = 1; i < N; i++) {
        scanf("%lld", &num);
        if(num > max) {
            max = num;
        }
    }

    printf("%lld\n", max);

    return 0;
}
