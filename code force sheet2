  //g)G - Factorial
  #include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);

        unsigned long long factorial = 1;

        for (int i = 1; i <= N; i++) {
            factorial *= i;
        }

        printf("%llu\n", factorial);
    }

    return 0;
}
