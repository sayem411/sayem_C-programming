  //i)I - Palindrome
  #include <stdio.h>

int main() {
    int n,original, reverse = 0, i;
    original=n;

    scanf("%d", &n);

    for (i = n; i > 0; i /=10) {
        reverse = reverse*10 +(i % 10); 
    }
   
    printf(" %d\n", reverse);

     if (original == reverse)
        printf("YES\n");
    else
        printf("NO\n");

    return 0;
}

