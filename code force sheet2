  //h)H - One Prime
  #include <stdio.h>

int main() {
    int x;
    scanf("%d", &x);

    if (x <= 1) {
        printf("NO\n");
        return 0;
    }

    for (int i = 2; i * i <= x; i++) {
        if (x % i == 0) {
            printf("NO\n");
            return 0;
        }
    }

    printf("YES\n");
    return 0;
}
